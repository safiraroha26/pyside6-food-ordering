  <property name="styleSheet">
   <string notr="true">/* ================== MAIN WINDOW ================== */
QWidget {
    background-color: #f4f6f8;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
    color: #2c3e50;
}

/* ================== TITLE ================== */
QLabel#labelTitle {
    font-size: 16px;
    font-weight: bold;
    color: #2c3e50;
}

/* ================== LABEL ================== */
QLabel {
    color: #2c3e50;
}

/* ================== GROUP BOX ================== */
QGroupBox {
    background-color: #e9edf2;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    font-weight: bold;
    color: #2c3e50;
}

/* ================== INPUT ================== */
QLineEdit {
    background-color: white;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 6px;
    color: #2c3e50;
}

QLineEdit:focus {
    border: 1px solid #3498db;
}

QSpinBox {
    background-color: white;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 4px 6px;
    color: #2c3e50;
    min-height: 28px;
}

QSpinBox:focus {
    border: 1px solid #3498db;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 18px;
    border-radius: 3px;
    background-color: #dcdde1;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #bdc3c7;
}

/* ================== TABLE ================== */
QTableWidget {
    background-color: #dfe6ee;
    border: none;
    gridline-color: #cfd6df;
    color: #2c3e50;
    alternate-background-color: #eaf1f8;
}

QHeaderView::section {
    background-color: #3498db;
    color: white;
    padding: 6px;
    border: none;
    font-weight: bold;
}

QTableWidget::item {
    padding: 4px;
}

QTableWidget::item:selected {
    background-color: #aed6f1;
    color: #2c3e50;
}

QTableWidget::item:hover {
    background-color: #d6eaf8;
}

/* ================== SCROLLBAR ================== */
QScrollBar:vertical {
    background: #ecf0f1;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #bdc3c7;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #95a5a6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #ecf0f1;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #bdc3c7;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #95a5a6;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ================== BUTTON (BASE) ================== */
QPushButton {
    border-radius: 6px;
    padding: 6px 12px;
    color: white;
    min-height: 30px;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #ecf0f1;
}

/* ================== BUTTON PESAN ================== */
QPushButton#btnPesan {
    background-color: #2ecc71;
}

QPushButton#btnPesan:hover {
    background-color: #27ae60;
}

QPushButton#btnPesan:pressed {
    background-color: #1e8449;
}

/* ================== BUTTON KERANJANG ================== */
QPushButton#btnKeranjang {
    background-color: #3498db;
}

QPushButton#btnKeranjang:hover {
    background-color: #2980b9;
}

QPushButton#btnKeranjang:pressed {
    background-color: #1a5276;
}

/* ================== BUTTON RIWAYAT ================== */
QPushButton#btnRiwayat {
    background-color: #8e44ad;
}

QPushButton#btnRiwayat:hover {
    background-color: #7d3c98;
}

QPushButton#btnRiwayat:pressed {
    background-color: #6c3483;
}

/* ================== BUTTON LOGOUT ================== */
QPushButton#btnLogout {
    background-color: #f39c12;
}

QPushButton#btnLogout:hover {
    background-color: #d68910;
}

QPushButton#btnLogout:pressed {
    background-color: #b7770d;
}
</string>
