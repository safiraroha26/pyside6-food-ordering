  <property name="styleSheet">
   <string notr="true">/* ================== GLOBAL ================== */
QWidget {
    background-color: #f4f6f8;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
    color: #2c3e50;
}

/* ================== TITLE ================== */
QLabel#labelTitle {
    font-size: 16px;
    font-weight: bold;
    color: #1f2d3d;
}

/* ================== LABEL ================== */
QLabel {
    color: #2c3e50;
}

/* ================== GROUP BOX ================== */
QGroupBox {
    background-color: #e9edf2;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    font-weight: bold;
    color: #34495e;
}

/* ================== INPUT ================== */
QLineEdit {
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 6px;
    background-color: #fafafa;
    color: #2c3e50;
}

QLineEdit:focus {
    border: 1px solid #3498db;
    background-color: #ffffff;
}

/* ================== TABLE ================== */
QTableWidget {
    border: none;
    background-color: #dfe6ee;
    gridline-color: #cfd6df;
    color: #2c3e50;
    alternate-background-color: #eaf1f8;
}

QHeaderView::section {
    background-color: #3498db;
    color: white;
    padding: 6px;
    border: none;
    font-weight: bold;
}

QTableWidget::item {
    padding: 4px;
    color: #2c3e50;
}

QTableWidget::item:selected {
    background-color: #aed6f1;
    color: #2c3e50;
}

QTableWidget::item:hover {
    background-color: #d6eaf8;
}

/* ================== SCROLLBAR ================== */
QScrollBar:vertical {
    background: #ecf0f1;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #bdc3c7;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #95a5a6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ================== BUTTON BASE ================== */
QPushButton {
    border-radius: 6px;
    padding: 6px 10px;
    color: white;
    min-height: 30px;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #ecf0f1;
}

/* ================== BUTTON SIMPAN ================== */
QPushButton#btn_simpan {
    background-color: #2ecc71;
}
QPushButton#btn_simpan:hover   { background-color: #27ae60; }
QPushButton#btn_simpan:pressed { background-color: #1e8449; }

/* ================== BUTTON UPDATE ================== */
QPushButton#btn_update {
    background-color: #3498db;
}
QPushButton#btn_update:hover   { background-color: #2980b9; }
QPushButton#btn_update:pressed { background-color: #1a5276; }

/* ================== BUTTON HAPUS ================== */
QPushButton#btn_hapus {
    background-color: #e74c3c;
}
QPushButton#btn_hapus:hover   { background-color: #c0392b; }
QPushButton#btn_hapus:pressed { background-color: #922b21; }

/* ================== BUTTON RESET ================== */
QPushButton#btnReset {
    background-color: #95a5a6;
}
QPushButton#btnReset:hover   { background-color: #7f8c8d; }
QPushButton#btnReset:pressed { background-color: #626567; }

/* ================== BUTTON SELESAI ================== */
QPushButton#btnSelesai {
    background-color: #2ecc71;
}
QPushButton#btnSelesai:hover   { background-color: #27ae60; }
QPushButton#btnSelesai:pressed { background-color: #1e8449; }

/* ================== BUTTON BATALKAN ================== */
QPushButton#btnBatalkan {
    background-color: #e74c3c;
}
QPushButton#btnBatalkan:hover   { background-color: #c0392b; }
QPushButton#btnBatalkan:pressed { background-color: #922b21; }

/* ================== BUTTON LOGOUT ================== */
QPushButton#btn_logout {
    background-color: #f39c12;
}
QPushButton#btn_logout:hover   { background-color: #d68910; }
QPushButton#btn_logout:pressed { background-color: #b7770d; }
</string>
