  <property name="styleSheet">
   <string notr="true">/* ================== MAIN WINDOW ================== */
QWidget {
    background-color: #f4f6f8;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
    color: #2c3e50;
}

/* ================== TITLE ================== */
QLabel#labelTitle {
    font-size: 16px;
    font-weight: bold;
    color: #2c3e50;
}

/* ================== LABEL USER ================== */
QLabel#labelUser {
    font-size: 12px;
    color: #7f8c8d;
}

/* ================== LABEL ================== */
QLabel {
    color: #2c3e50;
}

/* ================== GROUP BOX ================== */
QGroupBox {
    background-color: #e9edf2;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    font-weight: bold;
    color: #2c3e50;
}

/* ================== TABLE ================== */
QTableWidget {
    background-color: #dfe6ee;
    border: none;
    gridline-color: #cfd6df;
    color: #2c3e50;
    alternate-background-color: #eaf1f8;
}

QHeaderView::section {
    background-color: #8e44ad;
    color: white;
    padding: 6px;
    border: none;
    font-weight: bold;
}

QTableWidget::item {
    padding: 4px;
}

QTableWidget::item:selected {
    background-color: #d7bde2;
    color: #2c3e50;
}

QTableWidget::item:hover {
    background-color: #e8daef;
}

/* ================== SCROLLBAR ================== */
QScrollBar:vertical {
    background: #ecf0f1;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #bdc3c7;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #95a5a6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #ecf0f1;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #bdc3c7;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #95a5a6;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ================== BUTTON BASE ================== */
QPushButton {
    border-radius: 6px;
    padding: 6px 12px;
    color: white;
    min-height: 30px;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #ecf0f1;
}

/* ================== BUTTON KEMBALI ================== */
QPushButton#btnKembali {
    background-color: #7f8c8d;
}

QPushButton#btnKembali:hover {
    background-color: #626567;
}

QPushButton#btnKembali:pressed {
    background-color: #4d5656;
}

/* ================== BUTTON REFRESH ================== */
QPushButton#btnRefresh {
    background-color: #3498db;
}

QPushButton#btnRefresh:hover {
    background-color: #2980b9;
}

QPushButton#btnRefresh:pressed {
    background-color: #1a5276;
}

/* ================== BUTTON BATALKAN ================== */
QPushButton#btnBatalkan {
    background-color: #e74c3c;
    min-width: 160px;
}

QPushButton#btnBatalkan:hover {
    background-color: #c0392b;
}

QPushButton#btnBatalkan:pressed {
    background-color: #922b21;
}</string>
