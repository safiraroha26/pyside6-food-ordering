  <property name="styleSheet">
   <string notr="true">/* ===============================
   BACKGROUND UTAMA
================================= */
QWidget {
    background-color: #f4f6f8;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
    color: #2c3e50;
}

/* ===============================
   JUDUL APLIKASI
================================= */
QLabel#labelAppTitle {
    font-size: 17px;
    font-weight: bold;
    color: #2c3e50;
    padding: 10px;
}

/* ===============================
   LABEL JUDUL TAB (Selamat Datang / Buat Akun)
================================= */
QLabel#labelLoginTitle,
QLabel#labelDaftarTitle {
    font-size: 14px;
    font-weight: bold;
    color: #2c3e50;
    padding: 6px 0px;
}

/* ===============================
   LABEL FIELD
================================= */
QLabel {
    font-size: 12px;
    color: #2c3e50;
}

/* ===============================
   TOGGLE TAB: MASUK / DAFTAR
   (dihandle lewat Python _set_tab_style)
================================= */
QPushButton#btnTabLogin,
QPushButton#btnTabDaftar {
    border-radius: 0px;
    padding: 8px;
    font-weight: bold;
    font-size: 12px;
    min-height: 32px;
    border: none;
}

/* ===============================
   INPUT FIELD
================================= */
QLineEdit {
    background-color: white;
    color: #2c3e50;
    border: 1px solid #dcdcdc;
    border-radius: 8px;
    padding: 8px;
    font-size: 12px;
}

QLineEdit:focus {
    border: 1px solid #2ecc71;
}

/* ===============================
   BUTTON MASUK
================================= */
QPushButton#btn_login {
    background-color: #2ecc71;
    color: white;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
    min-height: 36px;
}

QPushButton#btn_login:hover {
    background-color: #27ae60;
}

QPushButton#btn_login:pressed {
    background-color: #219150;
}

/* ===============================
   BUTTON DAFTAR SEKARANG
================================= */
QPushButton#btn_daftar {
    background-color: #8e44ad;
    color: white;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
    min-height: 36px;
}

QPushButton#btn_daftar:hover {
    background-color: #7d3c98;
}

QPushButton#btn_daftar:pressed {
    background-color: #6c3483;
}

/* ===============================
   STACKED WIDGET (transparan)
================================= */
QStackedWidget {
    background-color: transparent;
}</string>
